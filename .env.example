# ================================
# RIDESHARETAHOE ENVIRONMENT VARIABLES
# ================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git!

# ================================
# 🗄️ SUPABASE (Database & Auth)
# ================================
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
# Locally, get them from `npx supabase status -o env`
# DO NOT LINK YOUR LOCAL ENV TO THE PRODUCTION DATABASE!
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Authorized external schedulers; never expose these as NEXT_PUBLIC values.
# Vercel Cron sends CRON_SECRET; other schedulers may use CRON_SECRET_TOKEN.
# The /api/cron routes accept either and return 503 when neither is set.
CRON_SECRET=replace-with-a-strong-random-secret
CRON_SECRET_TOKEN=replace-with-a-strong-random-secret
# Authorization does not enable processing. Review schema, legacy deletion
# requests, and queued marketing emails before enabling these independently.
ACCOUNT_DELETION_ENABLED=false
SCHEDULED_EMAILS_ENABLED=false
REENGAGEMENT_EMAILS_ENABLED=false
# Stable signing key, at least 32 characters; rotation invalidates old opt-out links.
EMAIL_UNSUBSCRIBE_SECRET=replace-with-at-least-32-random-characters

# Resend API Key
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Environment
NODE_ENV=development

# Optional: Stripe (if you're using payments)
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Optional: OpenAI (if you're using AI features)
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
